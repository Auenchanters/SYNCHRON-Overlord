# --- Credentials -------------------------------------------------------------
# Required only for the live Gemini path. Without it the app runs the
# deterministic audit engine and the sidebar shows "API : OFFLINE (MOCK)".
GOOGLE_API_KEY=your_key_here

# --- Live LLM switch ---------------------------------------------------------
# 1 = use Gemini for PO/invoice parsing and the auditor narrative.
# 0 = deterministic engine only (default; safest for demos and CI).
OVERLORD_LIVE_LLM=0

# --- Model selection ---------------------------------------------------------
# gemini-2.5-flash / gemini-2.0-flash return HTTP 404 for new keys.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# 0 keeps streamed stages fast; raise it for deeper auditor reasoning.
GEMINI_THINKING_BUDGET=0

# --- Server ------------------------------------------------------------------
GRADIO_SERVER_PORT=7860
GRADIO_ANALYTICS_ENABLED=False
