# --- Credentials -------------------------------------------------------------
# Hugging Face token: turns on Gemma 4 (google/gemma-4-26B-A4B-it) via Inference Providers.
# Without any key the app runs the deterministic audit engine.
HF_TOKEN=
GEMMA_MODEL=google/gemma-4-26B-A4B-it
HF_PROVIDER=auto
# Optional Gemini alternative (used when HF_TOKEN is empty, or with OVERLORD_LLM_PROVIDER=gemini).
GOOGLE_API_KEY=

# --- Live LLM switch ---------------------------------------------------------
# 1 = use the live model for the PO clause check, goods-receipt vision count, photo reading and the chatbot.
# 0 = deterministic engine only (default; safest for demos and CI).
OVERLORD_LIVE_LLM=0

# --- Model selection ---------------------------------------------------------
# gemini-2.5-flash / gemini-2.0-flash return HTTP 404 for new keys.
GEMINI_PRO_MODEL=gemini-3.5-flash
GEMINI_VISION_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# --- Server ------------------------------------------------------------------
GRADIO_SERVER_PORT=7860
GRADIO_ANALYTICS_ENABLED=False
